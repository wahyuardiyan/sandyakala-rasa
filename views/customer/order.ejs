<%
  const st = ORDER_STATUS[order.status];
  const ps = PAYMENT_STATUS[order.pay_status];
  const canPay = order.status === 'pending_payment' && ['unpaid', 'rejected'].includes(order.pay_status);
%>
<p class="sr-back"><a href="/pesanan">Kembali ke pesanan saya</a></p>
<span hidden data-order-watch="/pesanan/<%= order.code %>/status.json" data-status="<%= order.status %>" data-pay="<%= order.pay_status %>"></span>
<%- include('../partials/push-box') %>
<header class="sr-pagehead">
  <h1>Pesanan #<%= order.code %></h1>
  <p><%= fmtDateTime(order.created_at) %> dari <a class="sr-textlink" href="/toko/<%= order.store_slug %>"><%= order.store_name %></a></p>
  <%- include('../partials/state', { label: st.label, cls: st.cls }) %>
</header>

<%- include('../partials/track', { order: order }) %>
<% const chat = order.store_whatsapp ? waLink(order.store_whatsapp, 'Halo ' + order.store_name + ', saya ' + order.customer_name + '. Saya mau tanya soal pesanan #' + order.code + '.') : null; %>
<% if (chat) { %><p class="meta-line" style="margin-top:-.75rem">Ada pertanyaan? <a class="sr-textlink" href="<%= chat %>" target="_blank" rel="noopener">Chat penjual lewat WhatsApp</a></p><% } %>
<div class="sr-split<%= canPay ? ' pay-first' : '' %>">
  <section>
    <h2 class="sr-subh first">Rincian</h2>
    <dl class="sr-sum">
      <% order.items.forEach(function (it) { %><div><dt><%= it.qty %> × <%= it.name %></dt><dd><%= rp(it.price * it.qty) %></dd></div><% }) %>
      <div class="sep"><dt>Subtotal</dt><dd><%= rp(order.subtotal) %></dd></div>
      <div><dt>Ongkos antar<%= order.delivery_zone ? ' (' + order.delivery_zone + ')' : '' %></dt><dd><%= rp(order.delivery_fee) %></dd></div>
      <% if (order.discount > 0) { %><div><dt>Promo <%= order.voucher_code %></dt><dd>- <%= rp(order.discount) %></dd></div><% } %>
      <div class="total"><dt>Total</dt><dd><%= rp(order.total) %></dd></div>
    </dl>

    <h2 class="sr-subh"><%= order.fulfillment === 'delivery' ? 'Dikirim ke' : 'Diambil di toko' %></h2>
    <p class="sr-lines-txt"><b><%= order.customer_name %></b>, <%= order.customer_phone %></p>
    <% if (order.address) { %><p class="sr-lines-txt"><%= order.address %></p><% } %>
    <% if (order.note) { %><p class="hint">Catatan: <%= order.note %></p><% } %>

    <% if (['completed', 'cancelled'].includes(order.status)) { %>
      <form method="post" action="/pesanan/<%= order.code %>/ulang" style="margin-top:1.5rem">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="sr-btn">Pesan lagi</button>
        <span class="hint" style="margin-left:.5rem">Menu yang sama masuk keranjang.</span>
      </form>
    <% } %>

    <% if (order.status === 'delivering') { %>
      <h2 class="sr-subh">Sudah sampai?</h2>
      <form method="post" action="/pesanan/<%= order.code %>/diterima">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p class="hint" style="margin-top:0">Tekan setelah pesananmu benar-benar kamu terima.</p>
        <button class="sr-btn">Pesanan sudah diterima</button>
      </form>
    <% } %>
    <% if (order.status === 'completed') { %>
      <h2 class="sr-subh">Ulasan</h2>
      <% if (order.review) { %>
        <p class="sr-starshow"><%= '★'.repeat(order.review.rating) %><span><%= '★'.repeat(5 - order.review.rating) %></span></p>
        <% if (order.review.comment) { %><p class="sr-lines-txt"><%= order.review.comment %></p><% } %>
        <% if (order.review.reply) { %><p class="sr-reply"><b>Balasan penjual</b><%= order.review.reply %></p><% } %>
      <% } else { %>
        <form method="post" action="/pesanan/<%= order.code %>/ulasan" class="sr-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div data-stars class="sr-starpick" role="group" aria-label="Beri bintang"><input type="hidden" name="rating" value="">
            <% for (let i = 1; i <= 5; i++) { %><button type="button" aria-label="<%= i %> bintang">★</button><% } %></div>
          <p class="sr-starlabel" data-star-label aria-live="polite">Ketuk bintang untuk menilai</p>
          <div class="f"><label for="comment">Ceritakan pengalamanmu (boleh kosong)</label><textarea id="comment" name="comment" rows="2" maxlength="500"></textarea></div>
          <button class="sr-btn">Kirim ulasan</button>
        </form>
      <% } %>
    <% } %>
  </section>

  <aside class="sr-side">
    <h2>Pembayaran QRIS</h2>
    <p><%- include('../partials/state', { label: ps.label, cls: ps.cls }) %></p>

    <% if (canPay) { %>
      <% if (order.pay_status === 'rejected') { %><p class="sr-notice bad">Penjual belum menerima pembayaranmu: <%= order.reject_reason || 'mohon periksa kembali.' %></p><% } %>
      <div class="sr-qris">
        <p class="who"><%= order.qris_name || order.store_name %></p>
        <p class="lbl">Total yang dibayar</p>
        <p class="amt"><%= rp(order.total) %></p>
        <% if (order.qris_image) { %><img src="<%= order.qris_image %>" alt="Kode QRIS <%= order.store_name %>"><% } %>
        <p class="lbl">Scan dengan aplikasi pembayaran yang mendukung QRIS.</p>
      </div>
      <ol class="sr-how">
        <li>Buka aplikasi pembayaran, seperti OVO, GoPay, DANA, atau m-banking.</li>
        <li>Scan kode QR di atas.</li>
        <li>Masukkan nominal <b>persis <%= rp(order.total) %></b> bila diminta.</li>
        <li>Selesaikan pembayaran, lalu tekan tombol di bawah.</li>
      </ol>
      <p class="sr-notice">Sisa waktu bayar <b data-countdown="<%= new Date(order.expires_at).toISOString() %>">--:--</b>. Lewat dari itu, pesanan dibatalkan otomatis.</p>
      <form method="post" action="/pesanan/<%= order.code %>/bayar" enctype="multipart/form-data" class="sr-form" data-needs-file>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('../partials/uploader', { id: 'proof', name: 'proof', label: 'Bukti pembayaran (foto atau tangkapan layar dari aplikasi pembayaranmu)', shape: 'proof', current: null }) %>
        <button class="sr-btn lg full" disabled>Saya sudah membayar</button>
      </form>
      <p class="hint">Tombol aktif setelah kamu memilih bukti pembayaran. Penjual akan memeriksanya, dan pesanan baru diproses setelah uangnya terbukti masuk.</p>
      <form method="post" action="/pesanan/<%= order.code %>/batal" data-confirm="Batalkan pesanan ini?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sr-linkbtn bad">Batalkan pesanan</button></form>
    <% } else if (order.pay_status === 'claimed') { %>
      <p class="sr-notice info">Bukti pembayaranmu sudah terkirim. Penjual sedang memeriksanya. Muat ulang halaman ini untuk melihat kabar terbaru. Kalau lama tidak ada kabar, hubungi penjual.</p>
    <% } else if (order.pay_status === 'confirmed') { %>
      <p class="sr-notice ok">Pembayaran dikonfirmasi penjual pada <%= fmtDateTime(order.confirmed_at) %>.</p>
    <% } else if (order.status === 'cancelled') { %>
      <p class="sr-notice bad">Pesanan dibatalkan<%= order.cancelled_reason ? ': ' + order.cancelled_reason : '.' %></p>
    <% } %>
  </aside>
</div>
