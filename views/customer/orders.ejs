<header class="sr-pagehead"><h1>Pesanan saya</h1></header>
<%- include('../partials/push-box') %>
<div class="sr-story solo"><%- include('../partials/cerita') %></div>
<div class="sr-chips">
  <% tabs.forEach(function (t) { %><a href="/pesanan<%= t[0] === 'semua' ? '' : '?status=' + t[0] %>" <%- tab === t[0] ? 'class="is-active" aria-current="true"' : '' %>><%= t[1] %></a><% }) %>
</div>
<% if (!orders.length) { %>
  <div class="sr-empty">
    <%- include('../partials/illus', { kind: 'plate' }) %>
    <p>Belum ada pesanan di bagian ini.</p>
    <a class="sr-btn" href="/toko">Lihat toko</a>
  </div>
<% } else { %>
<ul class="sr-ords">
  <% orders.forEach(function (o) { const st = ORDER_STATUS[o.status]; %>
    <li>
      <div>
        <p class="meta">#<%= o.code %> · <%= fmtDateTime(o.created_at) %></p>
        <h3><a href="/pesanan/<%= o.code %>"><%= o.store_name %></a></h3>
        <p class="meta"><%= o.items.map(function (i) { return i.qty + '× ' + i.name; }).join(', ') %></p>
      </div>
      <div class="end">
        <%- include('../partials/state', { label: st.label, cls: st.cls }) %>
        <p class="total"><%= rp(o.total) %></p>
        <a class="sr-textlink" href="/pesanan/<%= o.code %>"><%= o.status === 'pending_payment' ? 'Bayar sekarang' : 'Lihat rincian' %></a>
      </div>
    </li>
  <% }) %>
</ul>
<% } %>
