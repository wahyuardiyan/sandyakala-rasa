<%
  const st = ORDER_STATUS[order.status]; const ps = PAYMENT_STATUS[order.pay_status];
  const canCancel = !['completed', 'cancelled'].includes(order.status);
%>
<p class="sr-back"><a href="/admin/pesanan">Kembali ke semua pesanan</a></p>
<p class="meta-line"><%= fmtDateTime(order.created_at) %> · <%- include('../partials/state', { label: st.label, cls: st.cls }) %> · Pembayaran: <%= ps.label.toLowerCase() %></p>
<div class="sr-split">
  <section>
    <h2 class="sr-subh first">Item pesanan</h2>
    <dl class="sr-sum">
      <% order.items.forEach(function (it) { %><div><dt><%= it.qty %> × <%= it.name %></dt><dd><%= rp(it.price * it.qty) %></dd></div><% }) %>
      <div class="sep"><dt>Subtotal</dt><dd><%= rp(order.subtotal) %></dd></div>
      <div><dt>Ongkos antar<%= order.delivery_zone ? ' (' + order.delivery_zone + ')' : '' %></dt><dd><%= rp(order.delivery_fee) %></dd></div>
      <% if (order.discount > 0) { %><div><dt>Promo <%= order.voucher_code %></dt><dd>- <%= rp(order.discount) %></dd></div><% } %>
      <div class="total"><dt>Total</dt><dd><%= rp(order.total) %></dd></div>
    </dl>
    <dl class="sr-defs">
      <dt>Toko</dt><dd><a class="sr-textlink" href="/toko/<%= order.store_slug %>" target="_blank" rel="noopener"><%= order.store_name %></a></dd>
      <dt>Pelanggan</dt><dd><%= order.customer_name %>, <a class="sr-textlink" href="tel:<%= order.customer_phone %>"><%= order.customer_phone %></a></dd>
      <dt><%= order.fulfillment === 'delivery' ? 'Diantar ke' : 'Diambil sendiri' %></dt><dd><%= order.address || '-' %></dd>
      <% if (order.note) { %><dt>Catatan</dt><dd><%= order.note %></dd><% } %>
      <% if (order.cancelled_reason) { %><dt>Dibatalkan</dt><dd><%= order.cancelled_reason %></dd><% } %>
      <% if (order.review) { %><dt>Ulasan</dt><dd><%= '★'.repeat(order.review.rating) %> <%= order.review.comment || '' %></dd><% } %>
    </dl>
  </section>
  <aside class="sr-side">
    <h2>Pembayaran</h2>
    <p><%- include('../partials/state', { label: ps.label, cls: ps.cls }) %></p>
    <% if (order.claimed_at) { %><p class="hint">Pelanggan menandai sudah bayar: <%= fmtDateTime(order.claimed_at) %></p><% } %>
    <% if (order.confirmed_at) { %><p class="hint">Dikonfirmasi penjual: <%= fmtDateTime(order.confirmed_at) %></p><% } %>
    <% if (order.proof_image) { %><p class="sr-proof"><a href="<%= order.proof_image %>" target="_blank" rel="noopener"><img src="<%= order.proof_image %>" alt="Bukti pembayaran"></a><span>Bukti dari pelanggan. Ketuk untuk memperbesar.</span></p><% } else { %><p class="hint">Belum ada bukti pembayaran.</p><% } %>
    <% if (canCancel) { %>
      <h2 class="sr-subh">Batalkan pesanan</h2>
      <form method="post" action="/admin/pesanan/<%= order.code %>/batal" class="sr-form" data-confirm="Batalkan pesanan ini? Pelanggan dan penjual akan diberi tahu.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="f"><label for="reason">Alasan (dikirim ke pelanggan dan penjual)</label><input id="reason" name="reason" maxlength="200" required></div>
        <button class="sr-btn danger">Batalkan pesanan</button>
      </form>
    <% } %>
  </aside>
</div>
