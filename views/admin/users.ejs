<div class="sr-toolbar">
  <form method="get" class="sr-searchline"><input name="q" value="<%= q %>" placeholder="Cari nama, email, atau telepon" maxlength="80" aria-label="Cari pengguna"><button class="sr-btn sm">Cari</button></form>
  <form method="post" action="/admin/pengguna/akun-uji" data-confirm="Buat akun Pelanggan Uji dan Penjual Uji?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sr-btn ghost sm">Buat akun uji</button></form>
</div>
<div class="sr-tablewrap"><table class="sr-table"><thead><tr><th>Nama</th><th>Kontak</th><th>Peran</th><th>Status</th><th>Daftar</th><th></th></tr></thead><tbody>
  <% users.forEach(function (u) { %>
    <tr>
      <td><b><%= u.name %></b></td><td><%= u.email || u.phone %></td>
      <td><%= u.role === 'customer' ? 'Pelanggan' : (u.role === 'merchant' ? 'Merchant' : 'Admin') %></td>
      <td><span class="sr-st <%= u.is_active ? 'ok' : 'bad' %>"><%= u.is_active ? 'Aktif' : 'Nonaktif' %></span></td>
      <td><%= fmtDate(u.created_at) %></td>
      <td><div class="sr-actions">
        <% if (u.role !== 'admin' && u.is_active) { %><form method="post" action="/admin/pengguna/<%= u.id %>/masuk-sebagai"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sr-btn sm">Masuk sebagai</button></form><% } %>
        <% if (u.role !== 'admin') { %><form method="post" action="/admin/pengguna/<%= u.id %>/atur-ulang" data-confirm="Buat tautan atur ulang password untuk <%= u.name %>? Tautan lama (kalau ada) tidak berlaku lagi."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sr-linkbtn">Atur ulang password</button></form><% } %>
        <% if (u.role !== 'admin') { %><form method="post" action="/admin/pengguna/<%= u.id %>/aktif" data-confirm="<%= u.is_active ? 'Nonaktifkan' : 'Aktifkan' %> akun ini?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sr-linkbtn <%= u.is_active ? 'bad' : '' %>"><%= u.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button></form><% } %>
      </div></td>
    </tr>
  <% }) %>
</tbody></table></div>
