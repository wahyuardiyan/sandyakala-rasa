<% const e = locals.errors || {}; %>
<h1 class="title">Password baru<%= locals.who ? ' untuk ' + who : '' %>.</h1>
<p class="lede">Pilih password yang belum pernah kamu pakai di tempat lain.</p>
<form method="post" novalidate data-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field <%= e.password ? 'has-error' : '' %>">
    <label for="password">Password baru (minimal 8 karakter)</label>
    <div class="pw">
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="72" autofocus <%= e.password ? 'aria-invalid="true"' : '' %>>
      <button type="button" data-reveal="password" aria-pressed="false">Lihat</button>
    </div>
    <p class="msg" <%= e.password ? '' : 'hidden' %>><%= e.password || '' %></p>
  </div>
  <div class="field <%= e.password_confirmation ? 'has-error' : '' %>">
    <label for="password_confirmation">Ulangi password baru</label>
    <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required maxlength="72" <%= e.password_confirmation ? 'aria-invalid="true"' : '' %>>
    <p class="msg" <%= e.password_confirmation ? '' : 'hidden' %>><%= e.password_confirmation || '' %></p>
  </div>
  <button class="btn" type="submit" data-busy="Menyimpan…">Simpan password</button>
</form>
