<%
  const isAdmin = locals.area === 'admin';
  const nav = isAdmin
    ? [['Ringkasan', '/admin', true], ['Toko', '/admin/toko'], ['Pengguna', '/admin/pengguna'], ['Pesanan', '/admin/pesanan'], ['Tagihan', '/admin/tagihan'], ['Ulasan', '/admin/ulasan'], ['Kategori', '/admin/kategori'], ['Legalitas', '/admin/legalitas'], ['Uji coba', '/admin/uji-coba'], ['Catatan error', '/admin/log']]
    : [['Ringkasan', '/merchant', true], ['Menu', '/merchant/menu'], ['Pesanan', '/merchant/pesanan'], ['Promo', '/merchant/promo'], ['Ulasan', '/merchant/ulasan'], ['Laporan', '/merchant/laporan'], ['Tagihan', '/merchant/tagihan'], ['Pemberitahuan', '/merchant/notifikasi'], ['Pengaturan toko', '/merchant/toko']];
%>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbf4ea">
  <title><%= locals.title ? title + ' · ' : '' %><%= isAdmin ? 'Admin' : 'Tokoku' %> · Sandyakala Rasa</title>
  <link rel="icon" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Young+Serif&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body class="min-h-screen flex flex-col"<% if (!isAdmin) { %> data-poll="/merchant/ringkas.json" data-latest="<%= locals.latestOrderId || 0 %>" data-attn="<%= locals.attn || 0 %>"<% } %>>
  <%- include('../partials/viewas') %>
  <%- include('../partials/latar') %>
  <a class="sr-skip" href="#isi">Langsung ke isi halaman</a>
  <header class="sr-head dash">
    <div class="sr-wrap">
      <a class="sr-brand" href="<%= isAdmin ? '/admin' : '/merchant' %>"><img src="/img/logo-mark.png" alt=""><span>Sandyakala Rasa</span></a>
      <span class="sr-area"><%= isAdmin ? 'Admin' : (locals.store ? store.name : 'Tokoku') %></span>
      <div class="sr-acts" style="margin-left:auto">
        <% if (!isAdmin && locals.store) { %><a class="sr-link" href="/toko/<%= store.slug %>"><span class="sr-long">Lihat halaman toko</span><span class="sr-short">Toko</span></a><% } else if (isAdmin) { %><a class="sr-link" href="/"><span class="sr-long">Lihat situs</span><span class="sr-short">Situs</span></a><% } %>
        <a class="sr-link sr-bell" href="/notifikasi" data-last="<%= locals.lastNotifId || 0 %>" data-uid="<%= user.id %>"<% if (locals.pushOn) { %> data-key="<%= locals.vapidKey %>" data-csrf="<%= csrfToken %>"<% } %> aria-label="Notifikasi"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9a6 6 0 1 1 12 0c0 5 2 6.5 2 6.5H4S6 14 6 9z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg><span class="sr-cartn <%= locals.unreadNotif > 0 ? '' : 'hidden' %>" data-notif-badge><%= locals.unreadNotif || 0 %></span></a>
        <span class="sr-who"><%= user.name.split(' ')[0] %></span>
        <form method="post" action="/keluar" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="sr-link">Keluar</button></form>
      </div>
    </div>
    <%- include('../partials/garland') %>
  </header>
  <nav class="sr-subnav" aria-label="<%= isAdmin ? 'Menu admin' : 'Menu toko' %>">
    <div class="sr-wrap">
      <% nav.forEach(function (n) { const active = n[2] ? path === n[1] : path.startsWith(n[1]); %>
        <a href="<%= n[1] %>" <%- active ? 'aria-current="page"' : '' %>><%= n[0] %><% if (n[1] === '/merchant/pesanan') { %><span class="sr-cartn <%= locals.attn > 0 ? '' : 'hidden' %>" data-attn-badge aria-label="perlu tindakan"><%= locals.attn || 0 %></span><% } %></a>
      <% }) %>
    </div>
  </nav>

  <main id="isi" class="sr-main dashmain flex-1">
    <div class="sr-wrap sr-dashmain">
      <% if (!isAdmin) { %><div id="new-order-bar" class="sr-notice info hidden" role="status">Ada pesanan baru atau yang perlu kamu cek. <a class="sr-textlink" href="/merchant/pesanan">Lihat pesanan</a></div><% } %>
      <header class="sr-pagehead"><h1><%= locals.title || '' %></h1></header>
      <% if (locals.flash) { %><div class="sr-flash <%= flash.type === 'error' ? 'error' : '' %>" role="status" style="margin-bottom:1.25rem"><%= flash.msg %></div><% } %>
      <% if (locals.hideStoreNotice) { %>
      <% } else if (!isAdmin && locals.store && store.status !== 'approved') { %>
        <p class="sr-notice"><b>Tokomu belum tampil untuk pelanggan.</b>
          <% if (store.status === 'pending') { %>Status: menunggu verifikasi admin. Sambil menunggu, lengkapi profil toko, unggah QRIS, dan tambahkan menu.
          <% } else { %>Status toko: <%= STORE_STATUS[store.status].label %>. Hubungi admin untuk informasi lebih lanjut.<% } %></p>
      <% } else if (!isAdmin && locals.store && store.qris_status !== 'approved') { %>
        <p class="sr-notice"><b>Pelanggan belum bisa checkout.</b>
          <% if (store.qris_status === 'none') { %>Unggah gambar QRIS resmi tokomu di <a class="sr-textlink" href="/merchant/toko">Pengaturan toko</a>.<% } else { %>QRIS-mu sedang diperiksa admin.<% } %></p>
      <% } %>
      <%- body %>
    </div>
  </main>
  <script src="/js/app.js" defer></script>
</body>
</html>
