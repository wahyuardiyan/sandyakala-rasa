# Salin file ini menjadi .env lalu sesuaikan.
PORT=3000
NODE_ENV=development
# Ganti dengan teks acak panjang (minimal 32 karakter). Jangan dibagikan.
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang-sekali-123456

# Database: sqlite (tanpa instalasi, paling mudah) atau mysql
DB_CLIENT=sqlite
SQLITE_FILE=./data/sandyakala.sqlite

# Kalau memakai MySQL (misalnya XAMPP), ubah DB_CLIENT=mysql lalu isi ini:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sandyakala_rasa

# Folder penyimpanan foto menu, logo, dan QRIS
UPLOAD_DIR=./uploads

# Alamat lengkap situs saat sudah online (dipakai untuk tautan dan pratinjau saat dibagikan).
# Contoh: https://sandyakala.my.id   (kosongkan saat uji di komputer sendiri)
APP_URL=

# Kontak admin yang tampil di halaman Bantuan dan saat pengguna lupa password.
# CONTACT_WA diisi nomor lokal, misalnya 081234567890.
CONTACT_EMAIL=
CONTACT_WA=

# ---- Pemberitahuan pesanan (opsional) ----
# Notifikasi browser (GRATIS, disarankan). Jalankan `npm run vapid`, salin hasilnya ke sini.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emailkamu@contoh.com

# (Opsional, berbayar/tidak resmi) WhatsApp lewat gateway (contoh: fonnte.com). Daftar, sambungkan nomor WA KHUSUS platform (scan QR), salin tokennya ke sini.
WA_GATEWAY_TOKEN=
# Nomor WA admin untuk kabar toko baru (opsional), contoh 081234567890
ADMIN_WA=
# Email lewat SMTP (opsional, perlu: npm install). Contoh Gmail: smtp.gmail.com, port 587, sandi aplikasi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Cadangan dan catatan error ----
# AUTO_BACKUP=0 mematikan cadangan otomatis (bawaan: aktif, tiap 12 jam, simpan 14 terakhir)
AUTO_BACKUP=1
BACKUP_DIR=./backups
LOG_DIR=./logs

# ---- Identitas pengelola (tampil di halaman Syarat dan Ketentuan) ----
# Isi nama usaha atau nama pengelola yang sebenarnya dan alamat korespondensi.
OPERATOR_NAME=
OPERATOR_ADDRESS=
